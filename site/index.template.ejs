<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Slides</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
  :root{
    --bg:#fafaf8;
    --surface:#ffffff;
    --ink:#1c211f;
    --ink-soft:#5b625d;
    --accent:#3e6658;
    --accent-soft:#e2ebe5;
    --border:#e2e4de;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#111814;
      --surface:#182420;
      --ink:#edefe9;
      --ink-soft:#a0aaa2;
      --accent:#7bb69a;
      --accent-soft:#20342c;
      --border:#283530;
    }
  }
  :root[data-theme="dark"]{
    --bg:#111814;
    --surface:#182420;
    --ink:#edefe9;
    --ink-soft:#a0aaa2;
    --accent:#7bb69a;
    --accent-soft:#20342c;
    --border:#283530;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"Source Serif 4", Georgia, serif;
    line-height:1.5;
  }
  .wrap{
    max-width:760px;
    margin:0 auto;
    padding:4.5rem 1.5rem 5rem;
  }

  header{
    margin-bottom:3rem;
  }
  .kicker{
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:0.75rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--accent);
    font-weight:600;
  }
  h1{
    font-family:"Archivo", "Helvetica Neue", sans-serif;
    font-weight:900;
    font-size:clamp(2.4rem, 7vw, 3.4rem);
    letter-spacing:-0.02em;
    text-wrap:balance;
    margin:0.4rem 0 0.6rem;
  }
  .lede{
    color:var(--ink-soft);
    font-size:1.05rem;
    max-width:46ch;
  }

  .decks{
    display:flex;
    flex-direction:column;
    gap:0.9rem;
  }
  .card{
    display:block;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:10px;
    padding:1.3rem 1.5rem;
    text-decoration:none;
    color:inherit;
    transition:border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover, .card:focus-visible{
    border-color:var(--accent);
    transform:translateX(2px);
  }
  .card:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  .card-title{
    font-family:"Archivo", sans-serif;
    font-weight:800;
    font-size:1.15rem;
    margin:0 0 0.3rem;
  }
  .card-desc{
    color:var(--ink-soft);
    font-size:0.95rem;
    margin:0;
  }
  .card-open{
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:0.72rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--accent);
    display:inline-block;
    margin-top:0.7rem;
  }

  .empty{
    color:var(--ink-soft);
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:0.9rem;
  }

  footer{
    margin-top:3.5rem;
    padding-top:1.4rem;
    border-top:1px solid var(--border);
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:0.78rem;
    color:var(--ink-soft);
  }
  footer a{color:var(--accent);}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="kicker">brpaz / slides</div>
    <h1>Slides</h1>
    <p class="lede">Talks and workshop decks, built with Slidev.</p>
  </header>

  <div class="decks">
    <% if (decks.length === 0) { %>
    <p class="empty">No decks yet — add one under decks/&lt;name&gt;/slides.md</p>
    <% } %>
    <% decks.forEach(deck => { %>
    <a class="card" href="./<%= deck.name %>/">
      <p class="card-title"><%= deck.title %></p>
      <% if (deck.description) { %>
      <p class="card-desc"><%= deck.description %></p>
      <% } %>
      <span class="card-open">Open deck &rarr;</span>
    </a>
    <% }) %>
  </div>

  <footer>
    <a href="https://github.com/brpaz/slides">source on GitHub</a>
  </footer>
</div>
</body>
</html>
